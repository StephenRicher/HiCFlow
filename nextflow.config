params {
    config = null
    samplesheet = null
    outdir = 'results'

    cutadapt = [
        forwardAdapter : 'AGATCGGAAGAGCACACGTCTGAACTCCAGTCA',
        reverseAdapter : 'AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT',
        overlap        : 6,
        errorRate      : 0.1,
        minimumLength  : 20,
        qualityCutoff  : 20
    ]

    hicup = [
        restrictionSequence : '^GATC',
        nofill              : false
    ]
}

process {
    executor = 'local'
    errorStrategy = 'terminate'

    cpus = 1
    memory = '2 GB'
    time = '1h'

    withLabel: process_low {
        cpus = 1
        memory = '2 GB'
        time = '2h'
    }

    withLabel: process_medium {
        cpus = 4
        memory = '8 GB'
        time = '8h'
    }

    withLabel: process_high {
        cpus = 8
        memory = '32 GB'
        time = '24h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    container {
        process.executor = 'local'
    }
}

docker {
    enabled = false
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

manifest {
    name = 'HiCFlow'
    description = 'Nextflow port of the HiCFlow diploid Hi-C workflow'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version = '0.1.0'
}
