params {
    samplesheet = 'example/config/samples.tsv'

    regions = 'example/config/regions.bed'

    outdir = 'results'

    genome = [
        S2Rplus: 'example/genome/BDGP6.28.fa.gz'
    ]

    genomeBuild = 'BDGP6'

    resolution = [
        base: 1000,
        bins: [3000]
    ]

    cutadapt = [
        forwardAdapter : 'AGATCGGAAGAGCACACGTCTGAACTCCAGTCA',
        reverseAdapter : 'AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT',
        overlap        : 6,
        errorRate      : 0.1,
        minimumLength  : 20,
        qualityCutoff  : 20,
        GCcontent      : 43
    ]

    hicup = [
        restrictionSequence : '^GATC',
        nofill              : false
    ]

    hic = [
        minBins              : 50,
        minDistance          : 300,
        maxLibraryInsertSize : 1000,
        minMappingQuality    : 15,
        keepSelfLigation     : false,
        keepSelfCircles      : false,
        makeBam              : false,
        compartmentScore     : false,
        threads              : 4,
        multiplicativeValue  : 10000,
        microC               : false,
    ]

    compareMatrices = [
        colourmap : 'bwr',
        zThreshold: 2,
        vMax      : 1,
        allPairs  : false,
        minSum    : 0
    ]

    plot = [
        coordinates      : 'example/config/plot_coordinates.bed',
        viewpoints       : 'example/config/viewpoints.bed',
        vlines           : 'example/config/vlines.bed',
        viewpointRange   : 150000,
        plotRep          : true,
        distanceNorm     : false,
        colourmap        : 'Purples',
        filetype         : 'svg',
        dpi              : 600,
        geneLabelFontSize: 10,
        maxLabels        : 60,
        coverageFontSize : 12
    ]

    genes = [
        gff3   : 'example/genome/BDGP6.32.105.gff3.gz',
        typeKey: 'biotype',
        label  : 'Name',
        geneID : 'Parent'
    ]

    bigWig = [
        CP190   : 'example/genome/CP190-dm6.bw',
        'Beaf-32': 'example/genome/Beaf32-dm6.bw',
        CTCF    : 'example/genome/CTCF-dm6.bw'
    ]

    qc = [
        runHiCRep    : true,
        hicRepBin    : 3000,
        coverageBins : 10000,
        samplePairs  : 100000,
        multiqcConfig: 'example/config/multiqc_config.yaml'
    ]
}

process {
    executor = 'local'
    errorStrategy = 'terminate'

    cpus = 1
    memory = '2 GB'
    time = '1h'

    withLabel: process_low {
        cpus = 1
        memory = '2 GB'
        time = '2h'
    }

    withLabel: process_medium {
        cpus = 4
        memory = '7 GB'
        time = '8h'
    }

    withLabel: process_high {
        cpus = 8
        memory = '32 GB'
        time = '24h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    container {
        process.executor = 'local'
    }
}

docker {
    enabled = false
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

manifest {
    name = 'HiCFlow'
    description = 'Nextflow port of the HiCFlow diploid Hi-C workflow'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version = '0.1.0'
}
