params {
    samplesheet = '/analysis/config/samples.tsv'

    regions = '/analysis/config/regions.bed'

    outdir = '/analysis/results'

    genome = [
        Human: '/analysis/genome/hg19.fa.gz'
    ]

    genomeBuild = 'hg19'

    resolution = [
        base: 5000,
        bins: [10000]
    ]

    cutadapt = [
        forwardAdapter : 'AGATCGGAAGAGCACACGTCTGAACTCCAGTCA',
        reverseAdapter : 'AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT',
        overlap        : 6,
        errorRate      : 0.1,
        minimumLength  : 20,
        qualityCutoff  : 20,
        GCcontent      : 43
    ]

    hicup = [
        restrictionSequence : '^GATC',
        nofill              : false
    ]

    hic = [
        minBins              : 50,
        minDistance          : 300,
        maxLibraryInsertSize : 1000,
        minMappingQuality    : 15,
        keepSelfLigation     : false,
        keepSelfCircles      : false,
        makeBam              : false,
        compartmentScore     : false,
        threads              : 4,
        multiplicativeValue  : 10000,
        microC               : false,
    ]

    compareMatrices = [
        colourmap : 'bwr',
        zThreshold: 2,
        vMax      : 1,
        allPairs  : false,
        minSum    : 0
    ]

    plot = [
        coordinates      : '/analysis/config/plot_coordinates.bed',
        viewpoints       : '/analysis/config/viewpoints.bed',
        vlines           : '/analysis/config/vlines.bed',
        viewpointRange   : 150000,
        plotRep          : true,
        distanceNorm     : false,
        colourmap        : 'Purples',
        filetype         : 'svg',
        dpi              : 600,
        geneLabelFontSize: 10,
        maxLabels        : 60,
        coverageFontSize : 12
    ]

    genes = [
        gff3   : '/analysis/genome/gencode.v19.annotation.gff3.gz',
        typeKey: 'gene_type',
        label  : 'gene_name',
        geneID : 'gene_id'
    ]

    bigWig = [:]

    qc = [
        runHiCRep    : true,
        hicRepBin    : 3000,
        coverageBins : 10000,
        samplePairs  : 100000,
        multiqcConfig: '/analysis/config/multiqc_config.yaml'
    ]

    loops = [
        detectLoops              : true,
        plot                     : true,
        peakWidth                : 2,
        windowSize               : 5,
        pValuePreselection       : 0.05,
        peakInteractionsThreshold: 5,
        obsExpThreshold          : 1.5,
        pValue                   : 0.05,
        maxLoopDistance          : 2000000,
        expected                 : null,
        differenceBins           : 20,
        maximumLineWidth         : 3
    ]
}

process {
    executor = 'local'
    errorStrategy = 'terminate'

    cpus = 1
    memory = '2 GB'
    time = '1h'

    withLabel: process_low {
        cpus = 1
        memory = '2 GB'
        time = '2h'
    }

    withLabel: process_medium {
        cpus = 4
        memory = '5 GB'
        time = '8h'
    }

    withLabel: process_high {
        cpus = 8
        memory = '32 GB'
        time = '24h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    container {
        process.executor = 'local'
    }
}

docker {
    enabled = false
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

manifest {
    name = 'HiCFlow'
    description = 'Nextflow port of the HiCFlow diploid Hi-C workflow'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version = '0.1.0'
}
