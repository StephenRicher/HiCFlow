params {
    samples = null
    deletions = null

    referenceUrl = 'https://hgdownload.soe.ucsc.edu/goldenPath/hg38/bigZips/latest/hg38.fa.gz'

    // Fixed 2,097,152 bp C.Origami window: chr1:66803384-68900536 (hg38).
    // Centres B1 and keeps WT and all four allele-deletion predictions directly comparable.
    predictionWindowStart = 66803384

    corigamiResourcesUrl = 'https://zenodo.org/record/7226561/files/corigami_data.tar.gz?download=1'
    runCorigami = false
    padding = 'follow'

    outdir = null

    corigamiPlotDpi = 300

    // Null selects the 99th percentile independently for each deletion.
    // Set a positive fixed value to enforce one comparable scale across alleles.
    corigamiDifferenceLimit = null
}

process {
    executor = 'local'
    errorStrategy = 'terminate'

    cpus = 1
    memory = '2 GB'
    time = '2h'

    withName: DOWNLOAD_FASTQ {
        cpus = 2
        memory = '4 GB'
        time = '48h'
        maxForks = 2
    }

    withName: PREPARE_REFERENCE {
        cpus = 2
        memory = '7 GB'
        time = '24h'
    }

    withName: ALIGN_AND_FILTER {
        cpus = 2
        memory = '7 GB'
        time = '48h'
        maxForks = 1
    }

    withName: MAKE_BIGWIG {
        cpus = 2
        memory = '4 GB'
        time = '8h'
    }

    withName: CORIGAMI_PREDICT {
        cpus = 2
        memory = '7 GB'
        time = '24h'
        maxForks = 1
    }

    withName: CORIGAMI_EDIT {
        cpus = 2
        memory = '7 GB'
        time = '24h'
        maxForks = 1
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

manifest {
    name = 'C.Origami input preparation'
    description = 'Prepare hg38 ATAC-seq and CTCF BigWigs for C.Origami'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version = '0.1.0'
}
